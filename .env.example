# ===============================================
# Google Gemini API Configuration & Model Tiers
# ===============================================
# Get API Key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------
# Tier 1: LITE MODEL (Fastest, low latency, low token cost)
# Best for: Text preprocessing, document metadata parsing, format validation
# -----------------------------------------------
LITE_MODEL=gemini-3.5-flash-lite
lite_model=gemini-3.5-flash-lite

# -----------------------------------------------
# Tier 2: MEDIUM MODEL (High speed + structured reasoning)
# Best for: RFP Criteria extraction, categorization, and 1-5 priority scoring
# -----------------------------------------------
MEDIUM_MODEL=gemini-3.6-flash
medium_model=gemini-3.6-flash

# -----------------------------------------------
# Tier 3: STRONG MODEL (Deep reasoning, long-form synthesis)
# Best for: Proposal gap analysis, weighted scorecard evaluation, section rewriting
# Note: Defaults to gemini-3.8-flash (or gemini-3.1-pro-preview with paid tier)
# -----------------------------------------------
STRONG_MODEL=gemini-3.8-flash
strong_model=gemini-3.8-flash

# Legacy / Default fallback
GEMINI_MODEL=gemini-3.6-flash
